# Kopiera till .env och fyll i. .env är gitignorerad och får aldrig committas.
# På Render sätts samma värden under Environment i tjänstens inställningar.

# Claude-API:t. Utan nyckel svarar appen med inspelade svar för filerna i demo/cases/.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-fable-5-2
CLAUDE_EFFORT=high
# Egen effort per steg (valfritt): CLAIMS, COVERAGE, DECISIONS, VISIT_CHECK, DRAFT, ASK
# CLAUDE_EFFORT_CLAIMS=medium

# Inloggning: ett enda konto, ingen registrering. Lämnas AUTH_PASSWORD tomt är
# inloggningen avstängd (bara för lokal utveckling, aldrig på webben).
AUTH_USERNAME=Demo
AUTH_PASSWORD=
# Hemlighet som signerar inloggningscookien. Sätt en lång slumpsträng på webben,
# annars loggas alla ut när servern startar om.
SESSION_SECRET=

# Inspelade svar: auto (standard) = när ingen API-nyckel finns, 1 = alltid, 0 = aldrig
DEMO_REPLAY=auto
